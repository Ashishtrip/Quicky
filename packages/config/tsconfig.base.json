{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@quicky/shared-types/*": ["packages/shared-types/src/*"],
      "@quicky/api-client/*": ["packages/api-client/src/*"],
      "@quicky/ui-kit/*": ["packages/ui-kit/src/*"],
      "@quicky/config/*": ["packages/config/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".turbo", ".expo"]
}