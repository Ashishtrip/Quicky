{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@quicky/shared-types/*": ["../../packages/shared-types/src/*"],
      "@quicky/api-client/*": ["../../packages/api-client/src/*"],
      "@quicky/ui-kit/*": ["../../packages/ui-kit/src/*"],
      "@quicky/config/*": ["../../packages/config/*"]
    }
  },
  "include": ["src/**/*", "*.config.js", "*.config.ts"],
  "exclude": ["node_modules", "android", "ios", "dist", "build"]
}