    "@prisma/client": "^5.10.0",
    "@quicky/config": "*",
    "@quicky/shared-types": "*",
    "@supabase/supabase-js": "^2.39.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "fastify": "^4.26.0",
    "firebase-admin": "^12.0.0",
    "google-auth-library": "^9.14.0",
    "googleapis": "^144.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.0",
    "razorpay": "^2.9.0",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.22.0"
  },
  "devDependencies": {
