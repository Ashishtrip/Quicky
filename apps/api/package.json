    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^8.57.0",
    "prisma": "^5.10.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^6.3.0",
    "tsx": "^4.7.0",
