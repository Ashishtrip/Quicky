{
  "cli": {
    "version": ">= 10.0.0",
    "requireCommit": false
  },
  "build": {
    "development": {
      "node": "22.12.0",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "node": "22.12.0",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://quicky-production.up.railway.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "22.12.0",
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://quicky-production.up.railway.app"
      }
    }
  }
}