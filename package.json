{
  "name": "quicky",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/config/eslint-config"
  ],
  "scripts": {
    "postinstall": "turbo run build --filter=\"./packages/*\"",
    "dev:customer": "yarn workspace @quicky/customer-app dev",
    "dev:store": "yarn workspace @quicky/store-app dev",
    "dev:api": "yarn workspace @quicky/api dev",
    "start": "yarn workspace @quicky/api start",
    "build": "yarn workspaces run build",
    "lint": "yarn workspaces run lint",
    "typecheck": "yarn workspaces run typecheck",
    "test": "yarn workspaces run test",
    "db:generate": "yarn workspace @quicky/api db:generate",
    "db:push": "yarn workspace @quicky/api db:push",
    "db:studio": "yarn workspace @quicky/api db:studio",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@types/tough-cookie": "^4.0.5",
    "react-test-renderer": "18.3.1",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "bullmq": "^5.80.2",
    "expo": "~52.0.49",
    "ioredis": "^5.11.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "redlock": "^5.0.0-beta.2",
    "socket.io": "^4.8.3",
    "use-sync-external-store": "^1.6.0"
  },
  "resolutions": {
    "react-native": "0.76.9"
  }
}
